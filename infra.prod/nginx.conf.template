# Processed by envsubst when the official nginx image starts.
# Replaces proxy.conf.json in production: /api, /notify_passengers and
# /realtime stay on the same origin as the frontend (HttpOnly cookie).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Client IP: Railway's edge proxy appends it as the last X-Forwarded-For entry.
# Without recursion, the entries the client may have sent itself are ignored.
set_real_ip_from 0.0.0.0/0;
set_real_ip_from ::/0;
real_ip_header X-Forwarded-For;

# Rate limits per client IP ($remote_addr after real_ip). The backend has
# looser limits of its own as a second layer.
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=ocr:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=realtime:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Behind Railway's proxy nginx does not know the public scheme and port:
    # redirects keep a relative Location so the browser resolves them.
    absolute_redirect off;

    client_max_body_size 20m;

    # The JS bundles shrink to about a quarter (html is always compressed once on).
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/xml application/javascript application/json image/svg+xml;

    # With the upstreams in variables nginx resolves them at request time (every
    # 10s at most) instead of only on startup: on each redeploy the backend and
    # the hub get a new private IP. NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;
    set $backend_upstream ${BACKEND_UPSTREAM};
    set $realtime_upstream ${REALTIME_UPSTREAM};

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    # Login, register and password recovery: brute force and mass emails.
    location /api/auth/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass $backend_upstream;
    }

    # The app calls these on every load / token expiry: general limit.
    location ~ ^/api/auth/(refresh|logout)$ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backend_upstream;
    }

    # Each read runs the OCR model (CPU-heavy).
    location = /api/admin/license-plate/read {
        limit_req zone=ocr burst=3 nodelay;
        proxy_pass $backend_upstream;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backend_upstream;
    }

    location /notify_passengers {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backend_upstream;
    }

    location /realtime {
        limit_req zone=api burst=40 nodelay;
        limit_conn realtime 20;
        proxy_pass $realtime_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Generated on startup from the environment: must not take the 1-year cache below.
    location = /env.js {
        add_header Cache-Control "no-store";
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpe?g|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The app only redirects "/" to /login on the client: a real 301 gives
    # crawlers a single URL for the entry screen.
    location = / {
        return 301 /login;
    }

    # Screens behind login (and the reset link, which carries a token): out of
    # search results. robots.txt must not disallow them, or crawlers never see this.
    # The SPA shell is served from this block (not as a try_files fallback, which
    # would jump to "location /" and drop these headers).
    location ~ ^/(home|dashboard|profile|notifications|reset-password)(/|$) {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow";
        try_files /index.csr.html =404;
    }

    # /login, /register and /forgot-password are prerendered at build time
    # (<route>/index.html); any other route gets the SPA shell (index.csr.html).
    # "$uri/index.html" instead of "$uri/" so nginx does not redirect /login to /login/.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /index.csr.html;
    }
}
