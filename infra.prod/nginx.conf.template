# Processed by envsubst when the official nginx image starts.
# Replaces proxy.conf.json in production: /api, /notify_passengers and
# /realtime stay on the same origin as the frontend (HttpOnly cookie).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
    }

    location /notify_passengers {
        proxy_pass ${BACKEND_UPSTREAM};
    }

    location /realtime {
        proxy_pass ${REALTIME_UPSTREAM};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Generated on startup from the environment: must not take the 1-year cache below.
    location = /env.js {
        add_header Cache-Control "no-store";
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpe?g|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
